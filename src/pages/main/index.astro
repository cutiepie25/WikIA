---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import BusquedaIA from '../../components/BusquedaIA.vue';
import { supabase } from '../../lib/supabase.server';

const POR_PAGINA = 5;

const CAMPOS =
	'id, nombre, descripcion, tipo_arquitectura, sitio_web, fecha_lanzamiento, imagen_link, compania(nombre), licencia(nombre)';

interface Modelo {
	id: number;
	nombre: string;
	descripcion: string;
	tipo_arquitectura: string | null;
	sitio_web: string | null;
	fecha_lanzamiento: string | null;
	imagen_link: string | null;
	compania?: { nombre: string } | null;
	licencia?: { nombre: string } | null;
}

function formatearFecha(iso: string | null): string {
	if (!iso) return '';

	const [anio, mes, dia] = String(iso).slice(0, 10).split('-');
	if (!anio || !mes || !dia) return String(iso);

	return `${dia}/${mes}/${anio}`;
}

function escaparLike(texto: string): string {
	return texto.replace(/([%_,])/g, '\\$1');
}

const idParam = Astro.url.searchParams.get('id');
const qParam = Astro.url.searchParams.get('q');
const paginaParam = Number(Astro.url.searchParams.get('page') ?? '1');

const id = (idParam ?? '').trim().slice(0, 9);
const idNum = Number(id);
const esBusquedaId = id !== '' && Number.isInteger(idNum) && idNum >= 1;

const q = (qParam ?? '').trim().slice(0, 50);

const esBusquedaNombre = !esBusquedaId && q.length > 0;
const esBusqueda = esBusquedaId || esBusquedaNombre;

let IAs: Partial<Modelo>[] = [];
let error: string | null = null;
let pagina = 1;
let total = 0;
let totalPaginas = 0;

if (esBusquedaId) {
	const { data, error: err } = await supabase
		.from('modelo')
		.select(CAMPOS)
		.eq('id', idNum)
		.limit(1);

	error = err?.message ?? null;
	IAs = (data ?? []) as Partial<Modelo>[];
	total = IAs.length;
	totalPaginas = 1;
} else if (esBusquedaNombre) {
	pagina = Number.isInteger(paginaParam) && paginaParam >= 1 ? paginaParam : 1;

	const conteo = await supabase
		.from('modelo')
		.select('*', { count: 'exact', head: true })
		.ilike('nombre', `%${escaparLike(q)}%`);

	error = conteo.error?.message ?? null;
	total = conteo.count ?? 0;
	totalPaginas = Math.ceil(total / POR_PAGINA);

	if (totalPaginas > 0 && pagina > totalPaginas) {
		pagina = totalPaginas;
	}

	const desde = (pagina - 1) * POR_PAGINA;
	const hasta = desde + POR_PAGINA - 1;

	const { data, error: err } = await supabase
		.from('modelo')
		.select(CAMPOS)
		.ilike('nombre', `%${escaparLike(q)}%`)
		.order('nombre')
		.range(desde, hasta);

	error = error ?? err?.message ?? null;
	IAs = (data ?? []) as Partial<Modelo>[];
} else {
	pagina = Number.isInteger(paginaParam) && paginaParam >= 1 ? paginaParam : 1;

	const conteo = await supabase.from('modelo').select('*', { count: 'exact', head: true });
	error = conteo.error?.message ?? null;
	total = conteo.count ?? 0;
	totalPaginas = Math.ceil(total / POR_PAGINA);

	if (totalPaginas > 0 && pagina > totalPaginas) {
		pagina = totalPaginas;
	}

	const desde = (pagina - 1) * POR_PAGINA;
	const hasta = desde + POR_PAGINA - 1;

	const { data, error: err } = await supabase
		.from('modelo')
		.select(CAMPOS)
		.order('id')
		.range(desde, hasta);

	error = error ?? err?.message ?? null;
	IAs = (data ?? []) as Partial<Modelo>[];
}

const filas = IAs.map((fila) => ({
	...fila,
	fecha_lanzamiento: formatearFecha(fila.fecha_lanzamiento),
	compania_nombre: fila.compania?.nombre ?? null,
	licencia_nombre: fila.licencia?.nombre ?? null,
}));
---

<Layout title="Listado | WikIA">
	<h1>Listado de modelos de IA</h1>

	<BusquedaIA
		IAs={filas}
		error={error}
		id={id}
		q={q}
		pagina={pagina}
		totalPaginas={totalPaginas}
		total={total}
		esBusqueda={esBusqueda}
		esBusquedaId={esBusquedaId}
		esBusquedaNombre={esBusquedaNombre}
	/>
</Layout>