---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { BusquedaIA }  from '../components/BusquedaIA.vue';
import { supabase } from '../lib/supabase';

const id = Astro.url.searchParams.get('id');

// Consulta al servidor en cada request: los datos llegan dentro del HTML,
// el componente no hace fetch desde el cliente.
// Sin id en la URL no se consulta nada, así no se listan todas las IAs.
let IAs = [];
if (id) {
	const { data } = await supabase.from('modelo').select('*').eq('id', Number(id));
	IAs = data ?? [];
}
---

<Layout>
	<h1>Welcome to WikIA</h1>

	<BusquedaIA IAs={IAs ?? []} />
</Layout>
