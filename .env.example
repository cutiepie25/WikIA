
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=cambia esta clave por la tuya

# Opcionales: sobrescrituras en tiempo de ejecucion para la ruta SSR (/main/).
# El servidor las lee del Worker; si no estan, cae a los valores PUBLIC_*.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=cambia esta clave por la tuya

# PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_PUBLISHABLE_KEY siguen siendo
# OBLIGATORIAS en tiempo de build: el codigo del navegador no puede leer el
# env del Worker y usa los valores que Vite inyecta en el bundle.
